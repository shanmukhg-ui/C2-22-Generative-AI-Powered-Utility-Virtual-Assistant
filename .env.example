# TechBharat AI CoE - Project C2-22: UtilityAI Environment Configuration

# DEMO MODE: When true, runs complete app end-to-end with local mock providers & zero external accounts
DEMO_MODE=true

# AI / LLM Configuration
# In DEMO_MODE, OPENAI_API_KEY can remain blank or use deterministic fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-2.5-flash
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=utility_virtual_assistant
USE_MOCK_MONGO=true

# Firebase Authentication (Optional in DEMO_MODE)
FIREBASE_PROJECT_ID=techbharat-c222-utility

# Security & Session Secrets
JWT_SECRET=utilityai-super-secret-key-change-in-production-2026
PORT=8000
FRONTEND_PORT=3000

