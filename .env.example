# TechBharat AI CoE - Project C2-22: UtilityAI Master Environment Configuration

# Server & Modes
PORT=8000
FRONTEND_PORT=5173
DEMO_MODE=false

# AI / LLM Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-2.5-flash
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=utility_virtual_assistant
USE_MOCK_MONGO=true

# Firebase Project Configuration
FIREBASE_PROJECT_ID=c2-22-utility-assistant
# Optional: Path to Firebase Admin service account key JSON file
FIREBASE_CREDENTIALS_PATH=
# Optional: Inline JSON string of Firebase Admin service account key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Frontend Firebase Web SDK Variables (placed in frontend/.env)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=c2-22-utility-assistant.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=c2-22-utility-assistant
VITE_FIREBASE_STORAGE_BUCKET=c2-22-utility-assistant.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1013417581459
VITE_FIREBASE_APP_ID=1:1013417581459:web:e9c819d68929248c1e2666
VITE_FIREBASE_MEASUREMENT_ID=

# Security
JWT_SECRET=utilityai-production-secret-replace-in-production
