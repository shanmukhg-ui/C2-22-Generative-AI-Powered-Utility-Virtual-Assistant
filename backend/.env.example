# TechBharat AI CoE - Project C2-22: Utility Virtual Assistant Backend Configuration

# Server Settings
PORT=8000
DEMO_MODE=false

# AI / LLM Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-2.5-flash
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=utility_virtual_assistant
USE_MOCK_MONGO=true

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=c2-22-utility-assistant
# Optional: Path to Firebase Admin service account key JSON file
# e.g., FIREBASE_CREDENTIALS_PATH=./service-account.json
FIREBASE_CREDENTIALS_PATH=
# Optional: Inline JSON string of service account key (useful in container/cloud environments)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Security & Secrets
JWT_SECRET=utilityai-production-secret-replace-in-production
CHROMA_PERSIST_DIRECTORY=./chroma_db
